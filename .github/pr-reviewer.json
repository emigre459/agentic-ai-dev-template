{
  "active": null,
  "review_rounds": {
    "max_incremental_before_final": 1,
    "max_incremental_after_final": 3,
    "max_fix_iterations": 5,
    "max_local_before_final": 3,
    "max_local_after_final": 3
  },
  "reviewers": {
    "bugbot": {
      "display_name": "Cursor Bugbot",
      "check_name": "Cursor Bugbot",
      "trigger_comment": "bugbot run",
      "bot_logins": ["cursor", "cursor[bot]"],
      "summary_marker": "<!-- BUGBOT_REVIEW -->",
      "clean_pattern": "found\\s+no\\s+new\\s+issues",
      "findings_pattern": "found\\s+(\\d+)\\s+potential\\s+issue",
      "reviewed_sha_pattern": null,
      "self_resolves_threads": true,
      "summary_in_issue_comments": false,
      "final_review_comment": null,
      "command_reply_marker": null,
      "final_review_done_pattern": null,
      "final_review_failed_pattern": null,
      "final_review_partial_pattern": null,
      "incremental_review_done_pattern": null,
      "incremental_review_no_changes_pattern": null,
      "incremental_review_failed_pattern": null,
      "incremental_review_partial_pattern": null,
      "unthreaded_finding_patterns": [],
      "rate_limited_pattern": null,
      "rate_limit_wait_pattern": null,
      "rate_limit_default_wait_minutes": null,
      "rate_limit_notice_marker": null,
      "local_preflight": null,
      "local_review": null
    },
    "coderabbit": {
      "display_name": "CodeRabbit",
      "check_name": "CodeRabbit",
      "trigger_comment": "@coderabbitai review",
      "bot_logins": ["coderabbitai", "coderabbitai[bot]"],
      "summary_marker": null,
      "clean_pattern": "No actionable comments were generated",
      "findings_pattern": "(?:Actionable comments posted:\\s*|Outside diff range comments \\()(\\d+)",
      "reviewed_sha_pattern": [
        "between\\s+[0-9a-f]{7,40}\\s+and\\s+([0-9a-f]{7,40})",
        "\"coveredCommitId\"\\s*:\\s*\"([0-9a-f]{7,40})\"",
        "change_assessment_commit\\s*:\\s*\"([0-9a-f]{7,40})\""
      ],
      "self_resolves_threads": true,
      "summary_in_issue_comments": true,
      "final_review_comment": "@coderabbitai full review",
      "command_reply_marker": "<!-- This is an auto-generated reply by CodeRabbit -->",
      "final_review_done_pattern": "\\bFull review finished\\b",
      "final_review_failed_pattern": "(?s)^(?!.*incremental review system).*\\b(?:Review failed|Head commit changed|base or head changed)\\b",
      "final_review_partial_pattern": "(?s)^(?!.*incremental review system).*\\bAction not completed\\b",
      "incremental_review_done_pattern": "(?s)^(?=.*incremental review system).*\\bReview finished\\b",
      "incremental_review_no_changes_pattern": "(?s)^(?=.*incremental review system).*\\bNo files to review\\b",
      "incremental_review_failed_pattern": "(?s)^(?=.*incremental review system).*\\b(?:Review failed|Head commit changed|base or head changed)\\b",
      "incremental_review_partial_pattern": "(?s)^(?=.*incremental review system).*\\bAction not completed\\b",
      "unthreaded_finding_patterns": [
        "(?s)<!-- final_review_risk_start -->(.*?)<!-- final_review_risk_end -->",
        "(?s)Outside diff range comments \\(\\d+\\)\\*\\*(.*?)(?:\\n---\\n|\\Z)"
      ],
      "rate_limited_pattern": "(?s)^(?!.*\\bAction performed\\b).*\\b(?:Review rate limited|included review limit is currently reached)\\b",
      "rate_limit_wait_pattern": "available in (\\d+) minutes?",
      "rate_limit_default_wait_minutes": 60,
      "rate_limit_notice_marker": "<!-- This is an auto-generated comment: rate limited by coderabbit.ai -->",
      "local_preflight": {
        "command": ["coderabbit", "usage", "--agent"],
        "state_path": "includedReviews.state",
        "available_states": ["available"],
        "remaining_path": "includedReviews.remaining",
        "full_capacity_ms_path": "includedReviews.fullCapacityInMs",
        "max_recheck_seconds": 300,
        "min_remaining": 2,
        "auth_command": ["coderabbit", "auth", "status", "--agent"],
        "authenticated_path": "authenticated",
        "remedies": {
          "not_installed": "Install the CodeRabbit CLI (https://docs.coderabbit.ai/cli#getting-started), then retry.",
          "not_authenticated": "Log the CodeRabbit CLI in: run `coderabbit auth login`, then retry.",
          "failed": "Run `coderabbit doctor` to diagnose the CodeRabbit CLI, then retry."
        }
      },
      "local_review": {
        "command": ["coderabbit", "review", "--agent", "--deep", "--committed", "--base-commit", "{base}"],
        "event_type_path": "type",
        "finding_event": "finding",
        "complete_event": "complete",
        "finding_fields": {
          "severity": "severity",
          "path": "fileName",
          "line": "startLine",
          "title": "title",
          "body": "comment"
        },
        "timeout_seconds": 1200,
        "start_failure_pattern": "Failed to start review"
      }
    }
  }
}
